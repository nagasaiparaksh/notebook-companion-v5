# --- Gnani Speech APIs ---
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v3.0

# --- Google Gemini ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash

# --- Embeddings (optional) ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

DATABASE_PATH=notes.db
GNANI_TTS_VOICE=Shivani

# --- Speed/robustness ---
LLM_FALLBACK_MODEL=
LLM_REASONING_EFFORT=none

# --- Optional backup AI provider ---
# LLM2_BASE_URL=https://api.groq.com/openai/v1
# LLM2_API_KEY=gsk_...
# LLM2_MODEL=llama-3.3-70b-versatile
# Accounts: logins are kept in a signed cookie. Set a long random SECRET_KEY when hosting online (otherwise one is made
# once and saved as .secret_key next to the database).
# SECRET_KEY=
